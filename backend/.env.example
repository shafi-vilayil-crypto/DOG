# Supabase / Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Demo API key for the playground
DOG_DEMO_API_KEY=dog_demo_xxxxxxxxxxxxxxxx

# AES-256 encryption key for provider credential vault (hex or base64)
DOG_ENCRYPTION_KEY=your-encryption-key-here

# Latency thresholds (milliseconds)
DOG_LATENCY_FULL_MS=2000
DOG_LATENCY_SHORT_MS=500
DOG_LATENCY_CRITICAL_MS=5000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Supabase JWT secret for auth verification
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_URL=https://your-project.supabase.co
